---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- if p.sitemap == false or p.layout == nil or p.layout == "redirect" -%}{%- continue -%}{%- endif -%}
  {%- unless p.url contains ".html" or p.url == "/" -%}{%- continue -%}{%- endunless %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ p.url | replace: "index.html", "" }}</loc>
  </url>
{%- endfor %}
</urlset>
